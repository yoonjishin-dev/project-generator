{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:project-templates:architecture",
  "title": "Architecture",
  "description": "ArchitectAgent 출력. 도메인 엔티티와 관계.",
  "type": "object",
  "additionalProperties": false,
  "required": ["entities"],
  "properties": {
    "entities": {
      "type": "array", "minItems": 1, "maxItems": 15,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "label", "description", "featureIds", "fields", "relations"],
        "properties": {
          "name": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]{0,39}$", "description": "PascalCase 단수형" },
          "label": { "type": "string", "minLength": 1, "maxLength": 30, "description": "한국어 이름" },
          "description": { "type": "string", "minLength": 1 },
          "featureIds": {
            "type": "array", "minItems": 1, "uniqueItems": true,
            "items": { "type": "string", "pattern": "^F-[0-9]{3}$" },
            "description": "이 엔티티가 필요한 PRD 기능 ID"
          },
          "fields": {
            "type": "array", "minItems": 1, "maxItems": 30,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["name", "label", "type", "required", "unique"],
              "properties": {
                "name": {
                  "type": "string",
                  "pattern": "^[a-z][A-Za-z0-9]{0,39}$",
                  "not": { "enum": ["id", "createdAt", "updatedAt"] }
                },
                "label": { "type": "string", "minLength": 1, "maxLength": 30 },
                "type": {
                  "type": "string",
                  "enum": ["STRING", "TEXT", "INTEGER", "LONG", "DECIMAL", "BOOLEAN", "DATE", "DATETIME"]
                },
                "required": { "type": "boolean" },
                "unique": { "type": "boolean" }
              }
            }
          },
          "relations": {
            "type": "array", "maxItems": 10,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["type", "fieldName", "target", "required"],
              "properties": {
                "type": { "type": "string", "enum": ["MANY_TO_ONE"] },
                "fieldName": { "type": "string", "pattern": "^[a-z][A-Za-z0-9]{0,39}$" },
                "target": { "type": "string", "pattern": "^[A-Z][A-Za-z0-9]{0,39}$" },
                "required": { "type": "boolean" }
              }
            }
          }
        }
      }
    }
  }
}
